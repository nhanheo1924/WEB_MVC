@model IEnumerable<SIMS_VER2.Models.Enrollment>
@{
    ViewData["Title"] = "My Grades";
    var student = ViewBag.Student as SIMS_VER2.Models.Student;
    var enrollmentsWithGrades = ViewBag.EnrollmentsWithGrades as IEnumerable<SIMS_VER2.Models.Enrollment> ?? new List<SIMS_VER2.Models.Enrollment>();
}

<h2>My Academic Transcript</h2>
<hr />

@if (student != null)
{
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Student Information</h5>
                    <div class="row">
                        <div class="col-md-3">
                            <p class="mb-1"><strong>Student Code:</strong> @student.StudentCode</p>
                        </div>
                        <div class="col-md-3">
                            <p class="mb-1"><strong>Name:</strong> @student.FullName</p>
                        </div>
                        <div class="col-md-3">
                            <p class="mb-1"><strong>Program:</strong> @student.Program</p>
                        </div>
                        <div class="col-md-3">
                            <p class="mb-1"><strong>Intake:</strong> @student.Intake</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (enrollmentsWithGrades.Any())
{
    <h4 class="mb-3">Courses with Grades</h4>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Class Code</th>
                    <th>Course Name</th>
                    <th>Course Code</th>
                    <th>Credits</th>
                    <th>Semester</th>
                    <th>Year</th>
                    <th>Grade</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in enrollmentsWithGrades)
                {
                    var grade = item.Grade!.Value;
                    var gradeClass = grade >= 8.0m ? "table-success" : grade >= 6.5m ? "table-info" : grade >= 5.0m ? "table-warning" : "table-danger";
                    var gradeTextClass = grade >= 8.0m ? "text-success fw-bold" : grade >= 6.5m ? "text-primary fw-bold" : grade >= 5.0m ? "text-warning fw-bold" : "text-danger fw-bold";
                    
                    <tr class="@gradeClass">
                        <td><strong>@item.CourseOffering?.ClassCode</strong></td>
                        <td>@item.CourseOffering?.Course?.CourseName</td>
                        <td>@item.CourseOffering?.Course?.CourseCode</td>
                        <td>@item.CourseOffering?.Course?.Credits</td>
                        <td>@item.CourseOffering?.Semester</td>
                        <td>@item.CourseOffering?.Year</td>
                        <td>
                            <span class="@gradeTextClass" style="font-size: 1.1em;">
                                @grade.ToString("F2")
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-@(item.Status == "ENROLLED" ? "success" : "secondary")">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    var totalCredits = enrollmentsWithGrades.Sum(e => e.CourseOffering?.Course?.Credits ?? 0);
    var weightedSum = enrollmentsWithGrades.Sum(e => (e.Grade!.Value) * (e.CourseOffering?.Course?.Credits ?? 0));
    var gpa = totalCredits > 0 ? weightedSum / totalCredits : 0m;

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">GPA Summary</h5>
                    <p class="mb-1"><strong>Total Credits:</strong> @totalCredits</p>
                    <p class="mb-1"><strong>Courses Completed:</strong> @enrollmentsWithGrades.Count()</p>
                    <p class="mb-0">
                        <strong>GPA:</strong> 
                        <span class="text-primary fw-bold" style="font-size: 1.2em;">@gpa.ToString("F2")</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <h5>No grades available</h5>
        <p>You don't have any grades recorded yet. Grades will appear here once your instructors have entered them.</p>
    </div>
}

<h4 class="mt-5 mb-3">All Enrollments</h4>
@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-secondary">
                <tr>
                    <th>Class Code</th>
                    <th>Course Name</th>
                    <th>Semester</th>
                    <th>Year</th>
                    <th>Status</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderByDescending(e => e.CourseOffering.Year).ThenByDescending(e => e.CourseOffering.Semester))
                {
                    <tr>
                        <td>@item.CourseOffering?.ClassCode</td>
                        <td>@item.CourseOffering?.Course?.CourseName</td>
                        <td>@item.CourseOffering?.Semester</td>
                        <td>@item.CourseOffering?.Year</td>
                        <td>
                            <span class="badge bg-@(item.Status == "ENROLLED" ? "success" : "secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            @if (item.Grade.HasValue)
                            {
                                var grade = item.Grade.Value;
                                var gradeTextClass = grade >= 8.0m ? "text-success fw-bold" : grade >= 6.5m ? "text-primary fw-bold" : grade >= 5.0m ? "text-warning fw-bold" : "text-danger fw-bold";
                                <span class="@gradeTextClass">@grade.ToString("F2")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    <a asp-action="MyCourses" class="btn btn-outline-primary">View My Courses</a>
</div>

