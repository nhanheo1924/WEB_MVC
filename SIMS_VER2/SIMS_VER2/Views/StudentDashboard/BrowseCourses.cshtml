@model IEnumerable<SIMS_VER2.Models.CourseOffering>
@{
    ViewData["Title"] = "Browse Courses";
    var student = ViewBag.Student as SIMS_VER2.Models.Student;
    var enrolledOfferings = ViewBag.EnrolledOfferings as List<int> ?? new List<int>();
}

<h2>Browse Available Courses</h2>
<hr />

@if (student != null)
{
    <div class="alert alert-info mb-4">
        <strong>Your Program:</strong> @student.Program | <strong>Intake:</strong> @student.Intake
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Class Code</th>
                    <th>Course Name</th>
                    <th>Course Code</th>
                    <th>Credits</th>
                    <th>Semester</th>
                    <th>Year</th>
                    <th>Instructor</th>
                    <th>Enrolled/Max</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var offering in Model)
                {
                    var isEnrolled = enrolledOfferings.Contains(offering.Id);
                    var currentEnrollments = offering.Enrollments?.Count ?? 0;
                    var isFull = currentEnrollments >= offering.MaxStudents;
                    
                    <tr class="@(isFull ? "table-warning" : "")">
                        <td><strong>@offering.ClassCode</strong></td>
                        <td>@offering.Course?.CourseName</td>
                        <td>@offering.Course?.CourseCode</td>
                        <td>@offering.Course?.Credits</td>
                        <td>@offering.Semester</td>
                        <td>@offering.Year</td>
                        <td>@(offering.Instructor?.Username ?? "TBA")</td>
                        <td>
                            <span class="@(isFull ? "text-danger fw-bold" : "")">
                                @currentEnrollments / @offering.MaxStudents
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-@(offering.Status == "OPEN" ? "success" : "primary")">
                                @offering.Status
                            </span>
                        </td>
                        <td>
                            @if (isEnrolled)
                            {
                                <span class="badge bg-info">Already Enrolled</span>
                            }
                            else if (isFull)
                            {
                                <span class="badge bg-danger">Full</span>
                            }
                            else
                            {
                                <form asp-action="Enroll" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseOfferingId" value="@offering.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary" 
                                            onclick="return confirm('Are you sure you want to enroll in @offering.ClassCode - @offering.Course?.CourseName?');">
                                        Enroll
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">
        <h5>No available courses found.</h5>
        <p>There are currently no courses available for enrollment matching your program.</p>
    </div>
}

<div class="mt-4">
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    <a asp-action="MyCourses" class="btn btn-outline-primary">View My Enrolled Courses</a>
</div>

