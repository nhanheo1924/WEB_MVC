@model IEnumerable<SIMS_VER2.Models.Enrollment>
@{
    ViewData["Title"] = "Manage Students & Grades";
    var offering = ViewBag.Offering as SIMS_VER2.Models.CourseOffering;
}

<h2>Manage Students & Grades - @offering?.ClassCode</h2>
<hr />

<!-- Debug: Check if view is loading -->
@if (offering == null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> Course offering data not found. Please go back and try again.
    </div>
}

<div class="mb-4">
    <div class="card shadow-sm border-primary">
        <div class="card-body">
            <h5 class="card-title text-primary">
                <strong>📚 Course Information</strong>
            </h5>
            <div class="row">
                <div class="col-md-4">
                    <p class="mb-1"><strong>Course:</strong> @offering?.Course?.CourseName</p>
                    <p class="mb-0"><strong>Code:</strong> @offering?.Course?.CourseCode</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1"><strong>Semester:</strong> @offering?.Semester @offering?.Year</p>
                    <p class="mb-0"><strong>Class Code:</strong> @offering?.ClassCode</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1"><strong>Enrolled:</strong> <span class="badge bg-info fs-6">@Model.Count()</span> / <span class="badge bg-secondary fs-6">@offering?.MaxStudents</span></p>
                    <p class="mb-0"><strong>Status:</strong> <span class="badge bg-@(offering?.Status == "ONGOING" ? "primary" : "success") fs-6">@offering?.Status</span></p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="alert alert-success">
        <strong>✅ Grade Entry Available:</strong> Click the green "Enter Grade" or "Update Grade" button in the Actions column to enter or update student grades.
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th style="width: 10%;">Student Code</th>
                    <th style="width: 20%;">Full Name</th>
                    <th style="width: 15%;">Program</th>
                    <th style="width: 10%;">Status</th>
                    <th style="width: 10%;">Grade</th>
                    <th style="width: 20%;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong class="text-primary">@item.Student?.StudentCode</strong></td>
                        <td>@item.Student?.FullName</td>
                        <td>@item.Student?.Program</td>
                        <td>
                            <span class="badge bg-@(item.Status == "ENROLLED" ? "success" : "secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            @if (item.Grade.HasValue)
                            {
                                var grade = item.Grade.Value;
                                var gradeClass = grade >= 8.0m ? "text-success fw-bold" : grade >= 6.5m ? "text-primary fw-bold" : grade >= 5.0m ? "text-warning fw-bold" : "text-danger fw-bold";
                                <span class="@gradeClass" style="font-size: 1.2em;">@grade.ToString("F2")</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Not graded</span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" 
                                    class="btn btn-success fw-bold shadow" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#gradeModal@(item.Id)" 
                                    style="min-width: 150px; font-size: 0.95em;">
                                <span class="me-1">⭐</span> @(item.Grade.HasValue ? "Update Grade" : "Enter Grade")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Grade Modals -->
    @foreach (var item in Model)
    {
        <div class="modal fade" id="gradeModal@(item.Id)" tabindex="-1" aria-labelledby="gradeModalLabel@(item.Id)" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title fw-bold" id="gradeModalLabel@(item.Id)">
                            ⭐ @(item.Grade.HasValue ? "Update Grade" : "Enter Grade")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="UpdateGrade" method="post" asp-controller="FacultyCourses">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="enrollmentId" value="@item.Id" />
                        <div class="modal-body">
                            <div class="alert alert-info mb-3">
                                <h6 class="fw-bold mb-2">Student Information:</h6>
                                <p class="mb-1">
                                    <strong>Code:</strong> <span class="text-primary">@item.Student?.StudentCode</span><br />
                                    <strong>Name:</strong> @item.Student?.FullName<br />
                                    <strong>Course:</strong> @ViewBag.Offering?.Course?.CourseName
                                </p>
                            </div>
                            <div class="mb-3">
                                <label for="grade@(item.Id)" class="form-label fw-bold fs-5">Grade (0-10):</label>
                                <input type="number" 
                                       class="form-control form-control-lg border-primary" 
                                       id="grade@(item.Id)" 
                                       name="grade" 
                                       value="@(item.Grade?.ToString("F2") ?? "")" 
                                       step="0.01" 
                                       min="0" 
                                       max="10"
                                       placeholder="Enter grade (0-10)"
                                       style="font-size: 1.2em;"
                                       required>
                                <div class="form-text">
                                    <i class="bi bi-info-circle text-primary"></i> 
                                    Enter a value between 0 and 10. Leave empty and submit to clear the grade.
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success fw-bold">
                                💾 Save Grade
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-warning shadow-sm">
        <h5><i class="bi bi-exclamation-triangle"></i> No Students Enrolled</h5>
        <p class="mb-0">There are no students enrolled in this course offering yet. Students can enroll through the "Browse Courses" page.</p>
    </div>
}

<div class="mt-4">
    <a asp-controller="FacultyDashboard" asp-action="Dashboard" class="btn btn-secondary">← Back to Dashboard</a>
    <a asp-controller="FacultyCourses" asp-action="MyOfferings" class="btn btn-outline-primary">My Offerings</a>
</div>
