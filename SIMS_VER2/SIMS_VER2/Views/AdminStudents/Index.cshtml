@model IEnumerable<SIMS_VER2.Models.Student>
@{
    ViewData["Title"] = "Manage Students";
}

<h2>Student List</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search by code, name, email..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary">Search</button>
        </div>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Student Code</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Program</th>
                    <th>Intake</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.StudentCode</strong></td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.Program</td>
                        <td>@item.Intake</td>
                        <td>
                            <span class="badge bg-@(item.Status == "ACTIVE" ? "success" : item.Status == "GRADUATED" ? "info" : "warning")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this student?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <h5>No students found</h5>
        <p>No students match your search criteria.</p>
    </div>
}
