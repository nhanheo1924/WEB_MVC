@model SIMS_VER2.Models.Student
@{
    ViewData["Title"] = "Chi tiết Sinh viên";
}

<h2>Chi tiết Sinh viên</h2>
<hr />

<dl class="row">
    <dt class="col-sm-2">Mã sinh viên</dt>
    <dd class="col-sm-10">@Model.StudentCode</dd>
    
    <dt class="col-sm-2">Họ tên</dt>
    <dd class="col-sm-10">@Model.FullName</dd>
    
    <dt class="col-sm-2">Ngày sinh</dt>
    <dd class="col-sm-10">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "N/A")</dd>
    
    <dt class="col-sm-2">Giới tính</dt>
    <dd class="col-sm-10">@(Model.Gender ?? "N/A")</dd>
    
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@(Model.Email ?? "N/A")</dd>
    
    <dt class="col-sm-2">Điện thoại</dt>
    <dd class="col-sm-10">@(Model.Phone ?? "N/A")</dd>
    
    <dt class="col-sm-2">Địa chỉ</dt>
    <dd class="col-sm-10">@(Model.Address ?? "N/A")</dd>
    
    <dt class="col-sm-2">Chương trình</dt>
    <dd class="col-sm-10">@(Model.Program ?? "N/A")</dd>
    
    <dt class="col-sm-2">Khóa</dt>
    <dd class="col-sm-10">@(Model.Intake ?? "N/A")</dd>
    
    <dt class="col-sm-2">Trạng thái</dt>
    <dd class="col-sm-10">@Model.Status</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>

