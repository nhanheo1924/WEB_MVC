@model SIMS_VER2.Models.User
@{
    ViewData["Title"] = "Faculty Profile";
}

<h2>My Profile</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Profile" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PasswordHash" />
            <input type="hidden" asp-for="Role" />
            <input type="hidden" asp-for="Active" />
            
            <div class="card mb-4">
                <div class="card-header">Account Information</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                        <small class="form-text text-muted">You can change your username. You will need to login again with the new username.</small>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">Account Details (Read-only)</div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Role:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info">@Model.Role</span>
                        </dd>
                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@(Model.Active ? "success" : "danger")">
                                @(Model.Active ? "Active" : "Inactive")
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-controller="FacultyDashboard" asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

