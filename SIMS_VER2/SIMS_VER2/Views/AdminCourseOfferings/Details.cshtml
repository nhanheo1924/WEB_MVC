@model SIMS_VER2.Models.CourseOffering
@{
    ViewData["Title"] = "Chi tiết Lớp học phần";
}

<h2>Chi tiết Lớp học phần</h2>
<hr />

<dl class="row">
    <dt class="col-sm-2">Mã lớp</dt>
    <dd class="col-sm-10">@Model.ClassCode</dd>
    
    <dt class="col-sm-2">Môn học</dt>
    <dd class="col-sm-10">@Model.Course?.CourseName</dd>
    
    <dt class="col-sm-2">Học kỳ</dt>
    <dd class="col-sm-10">@Model.Semester</dd>
    
    <dt class="col-sm-2">Năm</dt>
    <dd class="col-sm-10">@Model.Year</dd>
    
    <dt class="col-sm-2">Giảng viên</dt>
    <dd class="col-sm-10">@(Model.Instructor?.Username ?? "N/A")</dd>
    
    <dt class="col-sm-2">Sĩ số tối đa</dt>
    <dd class="col-sm-10">@Model.MaxStudents</dd>
    
    <dt class="col-sm-2">Trạng thái</dt>
    <dd class="col-sm-10">@Model.Status</dd>
</dl>

<div>
    <a asp-action="Students" asp-route-id="@Model.Id" class="btn btn-primary">Quản lý Sinh viên</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>

