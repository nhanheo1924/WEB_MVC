@model SIMS_VER2.Models.Course
@{
    ViewData["Title"] = "Chi tiết Môn học";
}

<h2>Chi tiết Môn học</h2>
<hr />

<dl class="row">
    <dt class="col-sm-2">Mã môn</dt>
    <dd class="col-sm-10">@Model.CourseCode</dd>
    
    <dt class="col-sm-2">Tên môn</dt>
    <dd class="col-sm-10">@Model.CourseName</dd>
    
    <dt class="col-sm-2">Mô tả</dt>
    <dd class="col-sm-10">@(Model.Description ?? "N/A")</dd>
    
    <dt class="col-sm-2">Số tín chỉ</dt>
    <dd class="col-sm-10">@Model.Credits</dd>
    
    <dt class="col-sm-2">Chương trình</dt>
    <dd class="col-sm-10">@(Model.Program ?? "N/A")</dd>
    
    <dt class="col-sm-2">Loại</dt>
    <dd class="col-sm-10">@(Model.Type ?? "N/A")</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>

