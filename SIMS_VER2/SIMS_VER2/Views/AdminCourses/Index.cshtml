@model IEnumerable<SIMS_VER2.Models.Course>
@{
    ViewData["Title"] = "Manage Courses";
}

<h2>Course List</h2>
<hr />

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New Course</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search by code, name..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary">Search</button>
        </div>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Course Code</th>
                    <th>Course Name</th>
                    <th>Credits</th>
                    <th>Program</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.CourseCode</strong></td>
                        <td>@item.CourseName</td>
                        <td>@item.Credits</td>
                        <td>@item.Program</td>
                        <td>
                            <span class="badge bg-info">@item.Type</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this course?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <h5>No courses found</h5>
        <p>No courses match your search criteria.</p>
    </div>
}

